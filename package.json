{
  "name": "@gonka24/forward-tools",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Wallet-independent operations and checks for Gonka Forward deals",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "bin": {
    "forward": "dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./inferenced": {
      "types": "./dist/src/adapters/inferenced.d.ts",
      "import": "./dist/src/adapters/inferenced.js"
    },
    "./keplr": {
      "types": "./dist/src/adapters/keplr.d.ts",
      "import": "./dist/src/adapters/keplr.js"
    }
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc",
    "test": "npm run build && node --test dist/test/*.test.js",
    "forward": "node dist/src/cli.js"
  },
  "dependencies": {
    "@cosmjs/crypto": "0.39.0",
    "@cosmjs/encoding": "0.39.0",
    "@cosmjs/proto-signing": "0.39.0",
    "cosmjs-types": "0.11.0",
    "protobufjs": "7.6.6",
    "long": "5.3.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src",
    "deployments",
    "docs",
    "examples",
    "provenance",
    "validation",
    "README.md",
    "LICENSE",
    "NOTICE"
  ]
}
